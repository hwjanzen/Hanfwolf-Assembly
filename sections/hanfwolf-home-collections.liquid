{% comment %}HW20261021 Collection entry points and ordering steps below the existing home banner.{% endcomment %}
<section class="hanfwolf-home page-width" id="hanfwolf-collections">
  <h2>{{ section.settings.heading | escape }}</h2>
  <div class="hanfwolf-home__collections">
    {%- for block in section.blocks -%}
      {%- assign selected_collection = block.settings.collection -%}
      <div class="hanfwolf-home__card" {{ block.shopify_attributes }}>
        {%- if selected_collection != blank -%}
          {%- if selected_collection.image != blank -%}
            {{ selected_collection.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 600, 900', sizes: '(min-width: 750px) 50vw, 100vw', alt: selected_collection.title }}
          {%- endif -%}
          <h3>{{ selected_collection.title | escape }}</h3>
          <a class="button" href="{{ selected_collection.url }}">{{ block.settings.link_label | escape }}</a>
        {%- elsif request.design_mode -%}
          <p>Bitte eine Collection in den Block-Einstellungen auswaehlen.</p>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
  <h2>So bestellen Sie Ihren Zuschnitt</h2>
  <ol class="hanfwolf-home__steps">
    <li>Seil wählen</li>
    <li>Zuschnitt konfigurieren</li>
    <li>Zusammenstellung prüfen und bestellen</li>
  </ol>
</section>
{% schema %}
{
  "name": "HANFWOLF Seil-Auswahl",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Ueberschrift", "default": "Unsere Seile" }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "limit": 2,
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "link_label", "label": "Button-Text", "default": "Seile entdecken" }
      ]
    }
  ],
  "presets": [
    { "name": "HANFWOLF Seil-Auswahl", "blocks": [{ "type": "collection" }, { "type": "collection" }] }
  ]
}
{% endschema %}
