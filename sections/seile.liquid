{%- style -%}
  .rope-configurator-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .rope-configurator-{{ section.id }} .rope-configurator__inner {
    max-width: 76rem;
  }

  .rope-configurator-{{ section.id }} .rope-configurator__intro {
    margin-bottom: 2.4rem;
  }

  .rope-configurator-{{ section.id }} .rope-configurator__cuts {
    display: grid;
    gap: 1.6rem;
  }

  .rope-configurator-{{ section.id }} .rope-cut {
    display: grid;
    grid-template-columns: minmax(14rem, 1fr) minmax(18rem, 1.4fr) auto;
    gap: 1.6rem;
    align-items: end;
    padding: 1.6rem 0;
    border-bottom: 0.1rem solid rgba(var(--color-foreground), 0.15);
  }

  .rope-configurator-{{ section.id }} .rope-cut__field,
  .rope-configurator-{{ section.id }} .rope-cut__presentation {
    display: grid;
    gap: 0.8rem;
  }

  .rope-configurator-{{ section.id }} .rope-cut__field input {
    width: 100%;
    min-height: 4.8rem;
    padding: 0.8rem 1.2rem;
    color: rgb(var(--color-foreground));
    background: rgb(var(--color-background));
    border: 0.1rem solid rgba(var(--color-foreground), 0.45);
    border-radius: var(--inputs-radius);
    font: inherit;
  }

  .rope-configurator-{{ section.id }} .rope-cut__options {
    display: flex;
    flex-wrap: wrap;
    gap: 1.6rem;
    min-height: 4.8rem;
    align-items: center;
  }

  .rope-configurator-{{ section.id }} .rope-cut__option {
    display: inline-flex;
    gap: 0.6rem;
    align-items: center;
  }

  .rope-configurator-{{ section.id }} .rope-cut__remove {
    min-width: 4.8rem;
    min-height: 4.8rem;
    border: 0;
    background: transparent;
    color: rgb(var(--color-foreground));
    cursor: pointer;
    font-size: 2.4rem;
  }

  .rope-configurator-{{ section.id }} .rope-configurator__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    margin-top: 2.4rem;
  }

  .rope-configurator-{{ section.id }} .rope-configurator__error {
    margin-top: 1.6rem;
    color: rgb(var(--color-error));
  }

  .rope-configurator-{{ section.id }} .rope-configurator__notice {
    margin-top: 1.2rem;
    color: rgba(var(--color-foreground), 0.75);
  }

  @media screen and (max-width: 749px) {
    .rope-configurator-{{ section.id }} .rope-cut {
      grid-template-columns: 1fr 1fr;
    }

    .rope-configurator-{{ section.id }} .rope-cut__presentation {
      grid-column: 1 / -1;
    }
  }
{%- endstyle -%}

<section
  class="rope-configurator-{{ section.id }} color-{{ section.settings.color_scheme }} gradient"
  data-rope-configurator-section
>
  <div class="page-width rope-configurator__inner">
    <div class="rope-configurator__intro">
      <h2 class="h1">{{ section.settings.heading | escape }}</h2>
      <p>{{ section.settings.description | escape }}</p>
    </div>

    <form
      id="RopeConfigurator-{{ section.id }}"
      data-rope-configurator
    >
      <div class="rope-configurator__cuts" data-rope-cuts></div>

      <div class="rope-configurator__actions">
        <button class="button button--secondary" type="button" data-add-rope-cut>
          Weiteren Zuschnitt hinzufügen
        </button>
        <button class="button" type="submit" data-rope-submit>
          In den Warenkorb
        </button>
      </div>

      <p class="rope-configurator__notice">
        Preis, Gewicht und Bestand werden von Shopify je 1 dm berechnet. Bitte pflege Preis und Gewicht der Variante je dm.
      </p>
      <p class="rope-configurator__error" role="alert" hidden data-rope-error></p>
    </form>
  </div>

  <template data-rope-cut-template>
    <fieldset class="rope-cut">
      <div class="rope-cut__field">
        <label data-length-label>Länge dieses Zuschnitts (m)</label>
        <input
          type="number"
          inputmode="decimal"
          min="0.5"
          max="500"
          step="0.1"
          value="1"
          required
          data-rope-length
        >
      </div>

      <div class="rope-cut__presentation">
        <span>Aufmachung</span>
        <div class="rope-cut__options">
          <label class="rope-cut__option">
            <input type="radio" value="Ring" checked data-rope-presentation>
            Ring
          </label>
          <label class="rope-cut__option">
            <input type="radio" value="Haspel" data-rope-presentation>
            Haspel
          </label>
        </div>
      </div>

      <button class="rope-cut__remove" type="button" aria-label="Zuschnitt entfernen" title="Zuschnitt entfernen" data-remove-rope-cut>
        &times;
      </button>
    </fieldset>
  </template>
</section>

<script
  src="/apps/hanfwolf-pricing/script"
  data-proxy-path="/apps/hanfwolf-pricing"
  data-disable-price-feature="true"
  defer
></script>

<script
  src="/apps/hanfwolf-pricing/rope-configurator-script"
  data-form-id="RopeConfigurator-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-variant-id="gid://shopify/ProductVariant/{{ product.selected_or_first_available_variant.id }}"
  data-cart-url="{{ routes.cart_url }}"
  data-config-url="/apps/hanfwolf-pricing/config"
  defer
></script>

{% schema %}
{
  "name": "Seil-Konfigurator",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Seil konfigurieren"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Beschreibung",
      "default": "      Lege Länge und Aufmachung für jeden gewünschten Zuschnitt fest."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Farbschema",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Abstand oben",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Abstand unten",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Seil-Konfigurator"
    }
  ]
}
{% endschema %}