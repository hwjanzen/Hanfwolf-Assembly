{%- style -%}
  .rope-configurator-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  .rope-configurator-{{ section.id }} .rope-configurator__cuts {
    display: grid;
    gap: 1.6rem;
  }
  .rope-configurator-{{ section.id }} .rope-cut {
    padding: 1.6rem;
    border: 1px solid rgba(var(--color-foreground), 0.3);
    min-width: 0;
  }
  .rope-configurator-{{ section.id }} .rope-cut__inputs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: 1.6rem;
    border: 0;
    padding: 0;
    min-width: 0;
  }
  .rope-configurator-{{ section.id }} .rope-cut__field {
    display: grid;
    gap: 0.8rem;
  }
  .rope-configurator-{{ section.id }} input,
  .rope-configurator-{{ section.id }} select {
    width: 100%;
    min-height: 4.8rem;
    padding: 0.8rem 1.2rem;
    color: rgb(var(--color-foreground));
    background: rgb(var(--color-background));
    border: 1px solid rgba(var(--color-foreground), 0.45);
    border-radius: var(--inputs-radius);
    font: inherit;
  }
  .rope-configurator-{{ section.id }} .rope-configurator__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    margin-top: 1.6rem;
  }
  .rope-configurator-{{ section.id }} .rope-configurator__error {
    color: rgb(var(--color-error, 180, 0, 0));
  }
  .rope-configurator-{{ section.id }} .rope-configurator__summary {
    margin-top: 2.4rem;
    overflow-x: auto;
  }
  .rope-configurator-{{ section.id }} table {
    width: 100%;
    border-collapse: collapse;
  }
  .rope-configurator-{{ section.id }} th,
  .rope-configurator-{{ section.id }} td {
    padding: 0.8rem;
    text-align: left;
    border-bottom: 1px solid rgba(var(--color-foreground), 0.2);
    vertical-align: top;
  }
{%- endstyle -%}

<section
  class="rope-configurator-{{ section.id }} color-{{ section.settings.color_scheme }} gradient"
  data-rope-configurator-section
>
  <div class="page-width">
    <h2 class="h1">{{ section.settings.heading | escape }}</h2>
    <p>{{ section.settings.description | escape }}</p>
    <form id="RopeConfigurator-{{ section.id }}" data-rope-configurator>
      <div class="rope-configurator__cuts" data-rope-cuts></div>
      <div class="rope-configurator__actions">
        <button class="button button--secondary" type="button" data-add-rope-cut disabled>
          Weiteren Zuschnitt hinzufügen
        </button>
        <button class="button button--secondary" type="button" data-rope-review disabled>
          Bestellübersicht prüfen
        </button>
      </div>
      <div class="rope-configurator__summary" data-rope-summary hidden>
        <h3>Ihre Zusammenstellung</h3>
        <table>
          <caption class="visually-hidden">Konfigurierte Zuschnitte</caption>
          <thead>
            <tr>
              <th scope="col">Zuschnitt</th>
              <th scope="col">Stück</th>
              <th scope="col">Länge je Stück</th>
              <th scope="col">Ausführung</th>
              <th scope="col">Stückpreis</th>
              <th scope="col">Gesamt</th>
              <th scope="col">Aktionen</th>
            </tr>
          </thead>
          <tbody data-rope-summary-rows></tbody>
        </table>
        <p data-rope-total></p>
        <button class="button button--secondary" type="button" data-rope-confirm disabled>
          Konfiguration bestätigen
        </button>
      </div>
      <p role="status" aria-live="polite" data-rope-overall-status></p>
      <button class="button" type="submit" data-rope-submit disabled>In den Warenkorb</button>
      <p>Die Warenkorbmenge entspricht der Anzahl gleicher Zuschnitte. Die Länge je Stück bleibt unverändert.</p>
      <p class="rope-configurator__error" role="alert" hidden data-rope-error></p>
      <button class="button button--secondary" type="button" hidden data-rope-reload>
        Konfigurator erneut laden
      </button>
    </form>
    <noscript>Bitte aktivieren Sie JavaScript, um Seile zu konfigurieren.</noscript>
  </div>
  <template data-rope-cut-template>
    <fieldset class="rope-cut">
      <legend>Zuschnitt</legend>
      <fieldset class="rope-cut__inputs" data-rope-inputs>
        <legend class="visually-hidden">Zuschnitt bearbeiten</legend>
        <div class="rope-cut__field">
          <label>
            Anzahl Stück
            <input type="number" min="1" max="999" step="1" value="1" required data-rope-quantity>
          </label>
        </div>
        <div class="rope-cut__field">
          <label>
            Länge je Stück (m)
            <input type="number" inputmode="decimal" min="0.5" max="500" step="0.1" value="1" required data-rope-length>
          </label>
        </div>
      </fieldset>
      <div class="rope-configurator__actions">
        <button class="button button--secondary" type="button" data-rope-finish>Zuschnitt fertigstellen</button>
        <button class="button button--secondary" type="button" data-rope-edit hidden>Bearbeiten</button>
        <button class="button button--secondary" type="button" data-remove-rope-cut>Entfernen</button>
      </div>
      <p role="status" aria-live="polite" data-rope-cut-status></p>
    </fieldset>
  </template>
</section>

<script
  src="/apps/hanfwolf-pricing/script"
  data-proxy-path="/apps/hanfwolf-pricing"
  data-disable-price-feature="true"
  defer
></script>
<script
  src="/apps/hanfwolf-pricing/rope-configurator-script"
  data-form-id="RopeConfigurator-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-product-id="gid://shopify/Product/{{ product.id }}"
  data-proxy-path="/apps/hanfwolf-pricing"
  data-cart-url="{{ routes.cart_url }}"
  defer
></script>
{% schema %}
{
  "name": "Seil-Konfigurator",
  "tag": "section",
  "class": "section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Seil konfigurieren" },
    {
      "type": "text", "id": "description", "label": "Beschreibung",
      "default": "Konfigurieren Sie Ihre Zuschnitte und prüfen Sie anschließend die Zusammenstellung."
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Farbschema", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Abstand oben", "default": 24 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Abstand unten", "default": 36 }
  ],
  "presets": [{ "name": "Seil-Konfigurator" }]
}
{% endschema %}
